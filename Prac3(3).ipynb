    "import pandas as pd\n",
    "\n",
    "# Load dataset\n",
    "df = pd.read_csv(\"housing - housing.csv\")\n",
    "\n",
    "# Calculate correlation\n",
    "correlation = df[\"total_rooms\"].corr(\n",
    "    df[\"median_house_value\"]\n",
    ")\n",
    "\n",
    "print(\"Correlation between total_rooms and median_house_value:\")\n",
    "print(correlation)"
   ]
  }
